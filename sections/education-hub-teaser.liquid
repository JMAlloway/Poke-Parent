<section class="education-teaser" aria-labelledby="edu-heading">
  <div class="container">
    <h2 id="edu-heading">{{ section.settings.heading }}</h2>
    <p class="edu-subtitle">{{ section.settings.subtitle }}</p>

    <div class="edu-cards">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url }}" class="edu-card" {{ block.shopify_attributes }}>
          <div class="edu-card-icon" aria-hidden="true">{{ block.settings.emoji }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.teaser }}</p>
        </a>
      {%- endfor -%}
    </div>

    <a href="/pages/parent-guide-hub" class="btn btn-secondary">View All Guides</a>
  </div>
</section>

{% schema %}
{
  "name": "Education Hub Teaser",
  "class": "section-education-teaser",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Free Parent Guides"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "You don't need to become a Pokémon expert. These short guides cover just enough to feel confident."
    }
  ],
  "blocks": [
    {
      "type": "guide_card",
      "name": "Guide Card",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Icon/emoji",
          "default": "📖"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Guide title",
          "default": "Pokémon 101 for Parents"
        },
        {
          "type": "text",
          "id": "teaser",
          "label": "Short description",
          "default": "Booster packs, decks, supplies — what you actually need to know."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Education Hub Teaser",
      "blocks": [
        {
          "type": "guide_card",
          "settings": {
            "emoji": "📖",
            "title": "Pokémon 101 for Parents",
            "teaser": "Booster packs, decks, supplies — what you actually need to know.",
            "url": "/pages/pokemon-101"
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "emoji": "🎲",
            "title": "What to Expect from Packs",
            "teaser": "They're randomized. Most won't have rare cards. Here's why that's okay.",
            "url": "/pages/what-to-expect-from-packs"
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "emoji": "🛡️",
            "title": "Card Protection Basics",
            "teaser": "Penny sleeves, top loaders, binders — what to use and when.",
            "url": "/pages/card-protection-basics"
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "emoji": "🔍",
            "title": "Avoiding Fakes",
            "teaser": "How to spot counterfeit cards and buy from trustworthy sources.",
            "url": "/pages/avoiding-fakes"
          }
        }
      ]
    }
  ]
}
{% endschema %}
