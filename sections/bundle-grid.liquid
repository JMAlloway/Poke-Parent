<section class="bundle-grid" aria-labelledby="bundles-heading">
  <div class="container">
    <h2 id="bundles-heading">{{ section.settings.heading }}</h2>
    <p class="bundle-grid-subtitle">{{ section.settings.subtitle }}</p>

    <div class="bundle-cards">
      {%- for block in section.blocks -%}
        <a
          class="bundle-card"
          href="{%- if block.settings.product_handle != blank -%}/products/{{ block.settings.product_handle }}{%- else -%}/collections/bundles{%- endif -%}"
          {{ block.shopify_attributes }}
        >
          <div class="bundle-card-image">
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w"
                sizes="(max-width: 600px) 100vw, 350px"
                alt="{{ block.settings.image_alt | default: block.settings.title }}"
                width="600"
                height="600"
                loading="lazy"
              >
            {%- else -%}
              <div class="bundle-card-placeholder" aria-hidden="true">
                <p>Bundle photo coming soon</p>
              </div>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="bundle-badge">{{ block.settings.badge }}</span>
            {%- endif -%}
          </div>
          <div class="bundle-card-info">
            <h3>{{ block.settings.title }}</h3>
            <p class="bundle-price">{{ block.settings.price_range }}</p>
            <p class="bundle-tagline">{{ block.settings.description }}</p>
            <span class="btn btn-primary bundle-view-btn">View Bundle</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle Grid",
  "class": "section-bundle-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Three Simple Bundles"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Each bundle is designed for a different level. Pick one, or let our quiz choose for you."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bundle photo"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (e.g. 'Most Popular')"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Bundle name",
          "default": "Starter Explorer"
        },
        {
          "type": "text",
          "id": "price_range",
          "label": "Price range",
          "default": "$49 – $59"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short tagline (1-2 sentences)",
          "default": "A gentle introduction for first-timers."
        },
        {
          "type": "text",
          "id": "product_handle",
          "label": "Product handle (URL slug)",
          "default": "starter-explorer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Grid",
      "blocks": [
        {
          "type": "bundle",
          "settings": {
            "title": "Starter Explorer",
            "price_range": "$49 – $59",
            "description": "A gentle introduction for first-timers.",
            "product_handle": "starter-explorer"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "badge": "Most Popular",
            "title": "Growing Collector",
            "price_range": "$79 – $89",
            "description": "More packs, better supplies, room to grow.",
            "product_handle": "growing-collector"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "title": "Confident Collector",
            "price_range": "$109 – $129",
            "description": "The full experience for serious collectors.",
            "product_handle": "confident-collector"
          }
        }
      ]
    }
  ]
}
{% endschema %}
