<section class="bundle-grid" aria-labelledby="bundles-heading">
  <div class="container">
    <h2 id="bundles-heading">{{ section.settings.heading }}</h2>
    <p class="bundle-grid-subtitle">{{ section.settings.subtitle }}</p>

    <div class="bundle-cards">
      {%- for block in section.blocks -%}
        <div class="bundle-card" {{ block.shopify_attributes }}>
          <div class="bundle-card-header">
            <span class="bundle-badge">{{ block.settings.badge }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p class="bundle-price">{{ block.settings.price_range }}</p>
          </div>
          <div class="bundle-card-body">
            <p>{{ block.settings.description }}</p>
            <h4>What's included:</h4>
            <ul class="bundle-includes" role="list">
              {%- assign items = block.settings.includes | split: '|' -%}
              {%- for item in items -%}
                <li>{{ item | strip }}</li>
              {%- endfor -%}
            </ul>
            <p class="bundle-best-for"><strong>Best for:</strong> {{ block.settings.best_for }}</p>
          </div>
          <div class="bundle-card-footer">
            {%- if block.settings.product_handle != blank -%}
              <a href="/products/{{ block.settings.product_handle }}" class="btn btn-primary">View Bundle</a>
            {%- else -%}
              <a href="/collections/bundles" class="btn btn-primary">View Bundle</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle Grid",
  "class": "section-bundle-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Three Simple Bundles"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Each bundle is designed for a different level. Pick one, or let our quiz choose for you."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle card",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (e.g. 'Most Popular')",
          "default": ""
        },
        {
          "type": "text",
          "id": "title",
          "label": "Bundle name",
          "default": "Starter Explorer"
        },
        {
          "type": "text",
          "id": "price_range",
          "label": "Price range",
          "default": "$49 – $59"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "default": "A gentle introduction. A few packs to open, sleeves to protect favorites, and a small binder to start organizing."
        },
        {
          "type": "text",
          "id": "includes",
          "label": "What's included (separate with |)",
          "default": "4–5 modern booster packs|100 penny sleeves|Small binder (holds ~60 cards)|Parent PDF guide"
        },
        {
          "type": "text",
          "id": "best_for",
          "label": "Best for",
          "default": "First-timers, younger kids, budget-conscious parents"
        },
        {
          "type": "text",
          "id": "product_handle",
          "label": "Product handle (URL slug)",
          "default": "starter-explorer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Grid",
      "blocks": [
        {
          "type": "bundle",
          "settings": {
            "title": "Starter Explorer",
            "price_range": "$49 – $59",
            "description": "A gentle introduction. A few packs to open, sleeves to protect favorites, and a small binder to start organizing.",
            "includes": "4–5 modern booster packs|100 penny sleeves|Small binder (holds ~60 cards)|Parent PDF guide",
            "best_for": "First-timers, younger kids, budget-conscious parents",
            "product_handle": "starter-explorer"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "badge": "Most Popular",
            "title": "Growing Collector",
            "price_range": "$79 – $89",
            "description": "More packs, better supplies, and room to grow. Great for kids who are already into it and want to build a real collection.",
            "includes": "8–10 modern booster packs|200 penny sleeves|Semi-rigid top loaders (10-pack)|Binder with side-loading pages|Expanded parent PDF guide",
            "best_for": "Kids with some experience, collectors and organizers",
            "product_handle": "growing-collector"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "title": "Confident Collector",
            "price_range": "$109 – $129",
            "description": "The full experience. Plenty of packs, premium protection supplies, a quality binder, and a storage guide for the long haul.",
            "includes": "12–15 modern booster packs|300 penny sleeves|Semi-rigid top loaders (25-pack)|Premium binder with side-loading pages|Expanded parent PDF guide|Card storage tips sheet",
            "best_for": "Experienced collectors, careful kids, bigger budgets",
            "product_handle": "confident-collector"
          }
        }
      ]
    }
  ]
}
{% endschema %}
